{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${MEMEX_PLUGIN_DIR}/hooks/gemini-cli-session-end.js",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memex daemon start",
            "name": "memex-daemon"
          }
        ]
      }
    ]
  }
}
